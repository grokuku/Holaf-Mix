[Desktop Entry]
# ============================================================================
#  holaf-mix.desktop — KDE / XDG launcher entry
# ============================================================================
#  Install:
#    From the tarball: substitute the two placeholders, then
#      sed -e "s|__EXEC_PATH__|$PWD|g" \
#          -e "s|__ICON_PATH__|$PWD/icons|g" holaf-mix.desktop \
#        > ~/.local/share/applications/holaf-mix.desktop
#    System-wide: /usr/local/share/applications/ (the PKGBUILD does the same
#    substitution with /usr/bin and /usr/share/holaf-mix/icons).
#    Then:   update-desktop-database ~/.local/share/applications/
# ============================================================================

Type=Application
Version=1.5
Name=Holaf-Mix
GenericName=Audio Mixer
Comment=Voicemeeter-like audio mixer for PipeWire with MIDI control
# Categories: see https://specifications.freedesktop.org/menu-spec/latest/
#   AudioVideo   = multimedia app
#   Audio        = audio-focused
#   Mixer        = audio mixer
Categories=AudioVideo;Audio;Mixer;
Keywords=audio;mixer;pipewire;midi;ladspa;fader;volume;

# The app IS the Rust binary `holaf-ui` (there is no launcher script and no
# Python any more).  `__EXEC_PATH__` is replaced at install time by the
# PKGBUILD / the command above.
Exec=__EXEC_PATH__/holaf-ui %U

# Fallback if you prefer the `holaf-mix` command (a 20-line shell script that
# only execs holaf-ui from the same directory):
#   Exec=__EXEC_PATH__/holaf-mix %U

# Same substitution as Exec: lets the desktop environment grey the entry out
# when the app is not installed at the expected place.
TryExec=__EXEC_PATH__/holaf-ui

# NOTE: `holaf-ui` drives the PipeWire backend IN-PROCESS (no daemon, no IPC),
# so nothing has to be started alongside it.  `holafd`/`holafctl` are installed
# in the same directory for automation and diagnostics, not for the window.

# Icon — KDE will pick the largest size it finds; we ship 16-512
Icon=__ICON_PATH__/holaf-mix

# Whether to show in the system tray
StartupNotify=true
StartupWMClass=Holaf-Mix
Terminal=false

# Mime types for "open with" support
MimeType=application/json;

# X-KDE specific (KIO / Plasma hints)
X-KDE-StartupNotify=true
X-KDE-FormFactors=desktop;laptop;
