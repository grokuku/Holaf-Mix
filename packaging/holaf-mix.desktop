[Desktop Entry]
# ============================================================================
#  holaf-mix.desktop — KDE / XDG launcher entry
# ============================================================================
#  Install:
#    User:   cp holaf-mix.desktop ~/.local/share/applications/
#    System: sudo cp holaf-mix.desktop /usr/local/share/applications/
#    Then:   update-desktop-database ~/.local/share/applications/
# ============================================================================

Type=Application
Version=1.5
Name=Holaf-Mix
GenericName=Audio Mixer
Comment=Voicemeeter-like audio mixer for PipeWire with MIDI control
# Categories: see https://specifications.freedesktop.org/menu-spec/latest/
#   AudioVideo   = multimedia app
#   Audio        = audio-focused
#   Mixer        = audio mixer
Categories=AudioVideo;Audio;Mixer;
Keywords=audio;mixer;pipewire;midi;ladspa;fader;volume;

# Path to the binary. %k expands to the location of this .desktop file
# so the launcher works whether installed system-wide or in the user's
# home directory. Update Exec if you install the binary elsewhere.
#
# Since migration B1 the app's window is the Rust/egui binary `holaf-ui`:
# it *is* the UI (the Qt interface only survives as the `HOLAF_UI=python`
# escape hatch).  `__EXEC_PATH__` is replaced at install time by the
# PKGBUILD / install script.
Exec=__EXEC_PATH__/holaf-ui %U

# Fallback (kept documented on purpose — uncomment ONE of them and comment the
# Exec above if holaf-ui is not installed):
#   # the holaf-mix launcher resolves holaf-ui itself and falls back to the Qt
#   # UI when the Rust binary is missing or cannot start:
#   Exec=__EXEC_PATH__/holaf-mix %U
#   # the Qt UI, explicitly (temporary escape hatch while the port is
#   # validated; the Rust UI is the default):
#   Exec=env HOLAF_UI=python __EXEC_PATH__/holaf-mix %U

# Same substitution as Exec: lets the desktop environment grey the entry out
# when the app is not installed at the expected place.
TryExec=__EXEC_PATH__/holaf-ui

# NOTE (Rust core): `holaf-ui` drives the PipeWire backend IN-PROCESS (no
# daemon, no IPC), so nothing has to be started alongside it.  The Qt fallback
# starts the `holafd` daemon itself; packages install holafd/holafctl NEXT TO
# the executables (/usr/bin), which is the first path src/launcher.py and
# src/backend/rust_launcher.py probe, so no extra Exec/Path entry or env var is
# needed.  If holafd is missing the Qt UI logs a warning and keeps running with
# the classic Python engine.

# Icon — KDE will pick the largest size it finds; we ship 16-512
Icon=__ICON_PATH__/holaf-mix

# Whether to show in the system tray
StartupNotify=true
StartupWMClass=Holaf-Mix
Terminal=false

# Show in the audio/multimedia submenu
Categories=AudioVideo;

# Mime types for "open with" support
MimeType=application/json;

# X-KDE specific (KIO / Plasma hints)
X-KDE-StartupNotify=true
X-KDE-FormFactors=desktop;laptop;
